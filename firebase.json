{
    "functions": [
        {
            "source": "functions",
            "codebase": "challenges"
        }
    ],
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "emulators": {
        "auth": { "host": "127.0.0.1", "port": 9099 },
        "functions": { "host": "127.0.0.1", "port": 5001 },
        "firestore": {
            "host": "127.0.0.1",
            "port": 8080
        },
        "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
        "singleProjectMode": true
    },
    "hosting": {
        "target": "flow-lens-player",
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "flow-lens-3f987",
